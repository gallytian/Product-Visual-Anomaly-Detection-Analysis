{
 ""cells"": [
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""# MVTec AD 数据探索\n"", ""\n"", ""本 notebook 用于探索和理解 MVTec AD 数据集的结构和特征。""]},
  {""cell_type"": ""code"", ""metadata"": {}, ""source"": [""import sys\n"", ""from pathlib import Path\n"", ""sys.path.insert(0, str(Path('..').resolve()))\n"", ""\n"", ""import os\n"", ""import numpy as np\n"", ""import pandas as pd\n"", ""import matplotlib.pyplot as plt\n"", ""from PIL import Image\n"", ""from collections import defaultdict\n"", ""from src.dataset import MVTecDataset\n"", ""\n"", ""plt.rcParams['font.sans-serif'] = ['SimHei']\n"", ""plt.rcParams['axes.unicode_minus'] = False""]},
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""## 1. 数据集统计""]},
  {""cell_type"": ""code"", ""metadata"": {}, ""source"": [""DATA_ROOT = '../data/raw/mvtec_ad2'\n"", ""CATEGORIES = ['bottle', 'cable', 'capsule', 'grid', 'hazelnut']\n"", ""\n"", ""stats = []\n"", ""for cat in CATEGORIES:\n"", ""    train_ds = MVTecDataset(DATA_ROOT, cat, split='train')\n"", ""    test_ds = MVTecDataset(DATA_ROOT, cat, split='test')\n"", ""    n_normal_test = sum(1 for _, _, l, _ in test_ds.samples if l == 0)\n"", ""    n_anomaly_test = sum(1 for _, _, l, _ in test_ds.samples if l == 1)\n"", ""    stats.append({\n"", ""        'category': cat,\n"", ""        'train_normal': len(train_ds),\n"", ""        'test_normal': n_normal_test,\n"", ""        'test_anomaly': n_anomaly_test,\n"", ""        'total': len(train_ds) + len(test_ds)\n"", ""    })\n"", ""\n"", ""pd.DataFrame(stats)""]},
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""## 2. 正常 vs 异常样本对比""]},
  {""cell_type"": ""code"", ""metadata"": {}, ""source"": [""cat = 'bottle'\n"", ""test_ds = MVTecDataset(DATA_ROOT, cat, split='test')\n"", ""\n"", ""fig, axes = plt.subplots(2, 4, figsize=(16, 8))\n"", ""normal_samples = [s for s in test_ds.samples if s[2] == 0][:4]\n"", ""anomaly_samples = [s for s in test_ds.samples if s[2] == 1][:4]\n"", ""\n"", ""for i, (path, _, _) in enumerate(normal_samples):\n"", ""    img = Image.open(path).convert('RGB')\n"", ""    axes[0, i].imshow(img)\n"", ""    axes[0, i].set_title('Normal')\n"", ""    axes[0, i].axis('off')\n"", ""\n"", ""for i, (path, mask_path, _) in enumerate(anomaly_samples):\n"", ""    img = Image.open(path).convert('RGB')\n"", ""    axes[1, i].imshow(img)\n"", ""    if mask_path and Path(mask_path).exists():\n"", ""        mask = Image.open(mask_path).convert('L')\n"", ""        axes[1, i].imshow(np.array(mask), cmap='jet', alpha=0.5)\n"", ""    axes[1, i].set_title('Anomaly')\n"", ""    axes[1, i].axis('off')\n"", ""\n"", ""plt.tight_layout()\n"", ""plt.savefig('../results/images/normal_vs_anomaly.png', dpi=150, bbox_inches='tight')\n"", ""plt.show()""]},
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""## 3. 图像尺寸分布""]},
  {""cell_type"": ""code"", ""metadata"": {}, ""source"": [""sizes = []\n"", ""for cat in CATEGORIES:\n"", ""    ds = MVTecDataset(DATA_ROOT, cat, split='train')\n"", ""    for path, _, _ in ds.samples[:10]:\n"", ""        img = Image.open(path)\n"", ""        sizes.append(img.size)\n"", ""\n"", ""sizes = np.array(sizes)\n"", ""plt.figure(figsize=(10, 4))\n"", ""plt.subplot(1, 2, 1)\n"", ""plt.hist(sizes[:, 0], bins=20)\n"", ""plt.xlabel('Width')\n"", ""plt.ylabel('Count')\n"", ""plt.title('Width Distribution')\n"", ""\n"", ""plt.subplot(1, 2, 2)\n"", ""plt.hist(sizes[:, 1], bins=20)\n"", ""plt.xlabel('Height')\n"", ""plt.ylabel('Count')\n"", ""plt.title('Height Distribution')\n"", ""\n"", ""plt.tight_layout()\n"", ""plt.show()""]},
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""## 4. 异常类型统计""]},
  {""cell_type"": ""code"", ""metadata"": {}, ""source"": [""defect_counts = defaultdict(int)\n"", ""for cat in CATEGORIES:\n"", ""    test_dir = Path(DATA_ROOT) / cat / 'test'\n"", ""    if test_dir.exists():\n"", ""        for defect_dir in test_dir.iterdir():\n"", ""            if defect_dir.is_dir() and defect_dir.name != 'good':\n"", ""                defect_counts[defect_dir.name] += len(list(defect_dir.glob('*')))\n"", ""\n"", ""plt.figure(figsize=(12, 6))\n"", ""plt.bar(defect_counts.keys(), defect_counts.values())\n"", ""plt.xticks(rotation=45)\n"", ""plt.ylabel('Count')\n"", ""plt.title('Defect Type Distribution')\n"", ""plt.tight_layout()\n"", ""plt.show()""]},
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""## 5. 环境验证""]},
  {""cell_type"": ""code"", ""metadata"": {}, ""source"": [""import torch\n"", ""import timm\n"", ""\n"", ""print(f'PyTorch: {torch.__version__}')\n"", ""print(f'CUDA available: {torch.cuda.is_available()}')\n"", ""if torch.cuda.is_available():\n"", ""    print(f'GPU: {torch.cuda.get_device_name(0)}')\n"", ""print(f'timm: {timm.__version__}')""]},
  {""cell_type"": ""markdown"", ""metadata"": {}, ""source"": [""环境检查完成！下一步：运行 \scripts/train.py\ 开始训练模型。""]}
 ],
